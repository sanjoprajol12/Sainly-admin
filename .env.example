# Base URL of the Sainly Studio API (the Express server in ../sainlystudio/server).
# Keep "/api" to use the Vite dev proxy, or set a full URL such as https://sainlystudio.com/api
VITE_API_URL=/api

# Origin that serves uploaded files ("/uploads/..."). Leave empty when the admin is served
# from the same origin as the API or when using the dev proxy.
VITE_ASSET_URL=

# Dev proxy target for /api and /uploads (used by `npm run dev` only)
VITE_PROXY_TARGET=http://localhost:5000
