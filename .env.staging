# Staging build (`npm run build:staging`). Only public VITE_* values belong here — never secrets.
# Full URL of the staging Sainly Studio API (e.g. the backend's Vercel preview/staging domain).
VITE_API_URL=https://staging.sainlystudio.com/api

# Origin that serves uploaded files ("/uploads/...").
VITE_ASSET_URL=https://staging.sainlystudio.com
