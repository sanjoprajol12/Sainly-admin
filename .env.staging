# Only public VITE_* values belong here — never secrets.
# "/api" and "/uploads" are proxied to the Sainly Studio backend (sainlystudio.vercel.app)
# by the rewrites in vercel.json, so the admin talks to its own origin and needs no CORS.
VITE_API_URL=/api

# Empty: uploaded files are served through the same /uploads proxy.
VITE_ASSET_URL=
